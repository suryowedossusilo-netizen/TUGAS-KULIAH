import itertools
import math
import time


def input_data_lokasi():
    lokasi = {}
    print("=== INPUT DATA LOKASI TSP (METODE BRUTE FORCE) ===")
    while True:
        try:
            jumlah = int(input("Masukkan jumlah titik/kota (minimal 3): "))
            if jumlah >= 3:
                break
            print("Jumlah titik minimal 3 agar membentuk rute tertutup.")
        except ValueError:
            print("Input tidak valid. Masukkan angka bulat.")

    for i in range(jumlah):
        while True:
            nama = (
                input(f"\nNama titik ke-{i+1} (contoh: A): ").strip().upper()
            )
            if not nama:
                print("Nama titik tidak boleh kosong.")
            elif nama in lokasi:
                print(f"Titik '{nama}' sudah ada. Gunakan nama lain.")
            else:
                break

        while True:
            try:
                x = float(input(f"Koordinat X untuk {nama}: "))
                y = float(input(f"Koordinat Y untuk {nama}: "))
                lokasi[nama] = (x, y)
                break
            except ValueError:
                print("Koordinat harus berupa angka.")

    while True:
        awal = (
            input(f"\nPilih titik awal dari {list(lokasi.keys())}: ")
            .strip()
            .upper()
        )
        if awal in lokasi:
            break
        print("Titik awal tidak ditemukan dalam daftar lokasi.")

    return lokasi, awal


def jarak(lokasi, p, q):
    return math.hypot(
        lokasi[p][0] - lokasi[q][0], lokasi[p][1] - lokasi[q][1]
    )


def brute_force_tsp(lokasi, awal):
    mulai_waktu = time.perf_counter()

    titik_lain = [t for t in lokasi if t != awal]
    rute_terbaik = []
    jarak_terpendek = float("inf")
    jumlah_kombinasi = 0

    # Mencoba semua kemungkinan urutan kunjungan
    for perm in itertools.permutations(titik_lain):
        jumlah_kombinasi += 1
        rute_sekarang = [awal] + list(perm) + [awal]
        total_sekarang = 0.0

        for i in range(len(rute_sekarang) - 1):
            total_sekarang += jarak(
                lokasi, rute_sekarang[i], rute_sekarang[i + 1]
            )

        if total_sekarang < jarak_terpendek:
            jarak_terpendek = total_sekarang
            rute_terbaik = rute_sekarang

    durasi = (time.perf_counter() - mulai_waktu) * 1000  # dalam milidetik
    return rute_terbaik, jarak_terpendek, durasi, jumlah_kombinasi


if __name__ == "__main__":
    lokasi, awal = input_data_lokasi()
    rute, total, waktu, kombinasi = brute_force_tsp(lokasi, awal)

    print("\n" + "=" * 50)
    print("HASIL PENCARIAN RUTE (BRUTE FORCE)")
    print("=" * 50)
    print(f"Rute terbaik     : {' -> '.join(rute)}")
    print(f"Total jarak      : {total:.2f}")
    print(f"Kombinasi dicek  : {kombinasi:,} rute")
    print(f"Waktu eksekusi   : {waktu:.4f} ms")
    print("=" * 50)
